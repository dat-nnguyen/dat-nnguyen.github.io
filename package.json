{
  "name": "personal-website",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "start": "node api-gateway/server.js",
    "predev": "node scripts/generate-static-content.js",
    "dev": "vite frontend",
    "build": "node scripts/generate-static-content.js && cd frontend && npx vite build --outDir ../dist --emptyOutDir",
    "preview": "vite preview frontend",
    "notify-subscribers": "node scripts/notify-subscribers.js",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "http-proxy-middleware": "^4.2.0",
    "marked": "^18.0.7",
    "mongoose": "^9.7.4",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "happy-dom": "^20.14.5",
    "nodemailer": "^10.0.10",
    "prettier": "^3.3.1",
    "supertest": "^7.3.0",
    "vite": "^5.1.6",
    "vitest": "^2.1.9"
  }
}
